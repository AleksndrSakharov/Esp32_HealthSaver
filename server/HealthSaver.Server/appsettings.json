{
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=healthsaver;Username=healthsaver;Password=healthsaver"
  },
  "Storage": {
    "RawDataPath": "Data/raw"
  },
  "Ingest": {
    "MaxLivePoints": 300
  },
  "Server": {
    "Urls": "http://0.0.0.0:5000"
  },
  "Discovery": {
    "Enabled": true,
    "UdpPort": 50505,
    "HttpPort": 5000,
    "IntervalSeconds": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
